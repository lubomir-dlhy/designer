{
  "name": "@lubomir-dlhy/designer",
  "version": "0.3.26",
  "type": "module",
  "description": "MCP + CLI for autonomous iteration of claude.ai/design — drives the design surface via agent-browser, downloads handoff bundles, and exposes a tasting harness for full-viewport variant comparison.",
  "license": "MIT",
  "author": "Provi Zhang",
  "homepage": "https://github.com/lubomir-dlhy/designer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lubomir-dlhy/designer.git"
  },
  "bugs": {
    "url": "https://github.com/lubomir-dlhy/designer/issues"
  },
  "keywords": [
    "claude",
    "claude-design",
    "mcp",
    "model-context-protocol",
    "design",
    "agent-browser",
    "anthropic"
  ],
  "bin": {
    "designer": "./bin/designer.mjs"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "mcp": "bun mcp-server.ts",
    "cli": "bun cli.ts",
    "setup": "bun cli.ts setup",
    "doctor": "bun cli.ts doctor",
    "test": "bun run check && bun test",
    "check": "tsc --noEmit",
    "prepack": "bun run check",
    "probe": "bun scripts/probe.ts",
    "preflight": "bun scripts/ci-preflight.ts",
    "probe:health": "bun scripts/ci-health.ts",
    "auto-heal": "bun scripts/auto-heal.ts",
    "smoke": "bash scripts/install-smoke.sh",
    "trace": "bun scripts/trace-spike.ts",
    "trace:analyze": "bun scripts/trace-analyze.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cross-spawn": "^7.0.6",
    "fflate": "^0.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "files": [
    "*.ts",
    "bin/",
    "skills/",
    "scripts/designer-chrome.sh",
    "scripts/designer-chrome.ps1",
    "selectors.json",
    "README.md",
    "LICENSE"
  ]
}
